# Local development settings. Copy to .env to change them. If there is no .env,
# the API loads this file (but never in production: with NODE_ENV=production
# every variable must be set on the host). These are local test values only.

PORT=3000
CLIENT_ORIGINS=http://localhost:5500
JWT_SECRET=dev-only-secret-change-me
INFERENCE_URL=http://localhost:8000

# MySQL connection string: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:root@localhost:3306/moderation

# A message goes to a moderator when its highest score is at or above this.
# Masking uses per-label thresholds in api/decide.js.
REVIEW_THRESHOLD=0.5
FREE_CALLS=20

# Reverse proxies in front of the API (set to 1 on Railway).
TRUST_PROXY=0

# Test accounts created on first start.
SEED_ADMIN_EMAIL=admin@test.local
SEED_ADMIN_PASSWORD=admin-test-123
SEED_MODERATOR_EMAIL=mod@test.local
SEED_MODERATOR_PASSWORD=mod-test-123
SEED_USER_EMAIL=player@test.local
SEED_USER_PASSWORD=player-test-123
