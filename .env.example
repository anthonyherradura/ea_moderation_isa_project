# Copy to .env and change the values. If there is no .env, the API loads this
# file so the prototype runs with zero setup. These are local test values only.

PORT=3000
CLIENT_ORIGINS=http://localhost:5500
JWT_SECRET=dev-only-secret-change-me
INFERENCE_URL=http://localhost:8000

# Scores are 0..1. At or above REVIEW the message goes to a moderator;
# at or above MASK it is masked straight away (and can still be appealed).
REVIEW_THRESHOLD=0.5
MASK_THRESHOLD=0.9
FREE_CALLS=20

# Test accounts created on first start.
SEED_ADMIN_EMAIL=admin@test.local
SEED_ADMIN_PASSWORD=admin-test-123
SEED_MODERATOR_EMAIL=mod@test.local
SEED_MODERATOR_PASSWORD=mod-test-123
